{
  // Values remain local; evidence records only the key.
  "name": "example-worker",
  "main": "dist/index.js",
  "compatibility_date": "2026-01-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "example",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "DEPLOY_ENV": "example"
  }
}
