{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/hancoinkr/workers-release-proof/v0.2.0/schemas/config-v1.schema.json",
  "title": "Workers Release Proof configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "artifactDirectories": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "migrationDirectories": {
      "$ref": "#/$defs/stringArray"
    },
    "wranglerConfig": {
      "type": "string",
      "minLength": 1
    },
    "wranglerEnvironment": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "phase": {
      "enum": [
        "predeploy",
        "production"
      ]
    },
    "maxEvidenceAgeMinutes": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "requireCleanWorktree": {
      "type": "boolean"
    },
    "rollbackRecord": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "healthChecks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/healthCheck"
      }
    },
    "secretScan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exclude": {
          "$ref": "#/$defs/stringArray"
        }
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "healthCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "expectedStatus": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "assertions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "equals"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "equals": {}
            }
          }
        }
      }
    }
  }
}
